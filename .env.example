# ==============================================================================
# Anypod Environment Configuration (.env)
# ==============================================================================

# Server port to listen on
PORT=8788

# Base URL of your Anypod instance (used for magic login links and emails)
# Set this to your LAN IP, Tailscale address, or reverse proxy domain:
# e.g. http://192.168.1.100:8788 or https://anypod.org
APP_URL=http://localhost:8788

# Sender email address for outgoing emails
FROM_EMAIL="Anypod <login@anypod.local>"

# Resend API Key for sending magic login links (optional)
# Free tier gives 3,000 emails/month at https://resend.com
# If LEFT EMPTY: Anypod runs in 100% offline mode! The magic login link will be
# displayed directly in the web UI and logged to the Docker console output.
RESEND_API_KEY=

# Secret token required to trigger the Cleaner Monday cron cleanup endpoint (/api/cron/cleanup)
# Generate any random string:
CRON_SECRET=
