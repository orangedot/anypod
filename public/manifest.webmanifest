{
  "id": "/?source=pwa",
  "name": "Anypod — Private Podcast Player",
  "short_name": "Anypod",
  "description": "Free, open-source podcast player. No account. No ads. No tracking. Works offline.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#121214",
