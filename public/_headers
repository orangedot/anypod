/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), camera=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; object-src 'none'; base-uri 'self'; media-src 'self' blob: http: https:; img-src 'self' data: http: https:; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; frame-src 'self' https://anypod.org https://*.anypod.org https://www.youtube.com; connect-src 'self' http: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;

/storage-bridge.html
  X-Frame-Options: ALLOWALL
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; frame-ancestors 'self' https://*.anypod.org https://anypod.org http://localhost:* http://127.0.0.1:*
  Cache-Control: no-cache, must-revalidate

# HTML documents revalidate cleanly while preserving browser Back-Forward Cache (bfcache)
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/dist/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/app/*
  Cache-Control: no-cache, must-revalidate

/shared/*
  Cache-Control: no-cache, must-revalidate

# Permanent caching for self-hosted immutable fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Fingerprinted production bundles cached forever as immutable static files
/dist/app.min.js
  Cache-Control: public, max-age=31536000, immutable

/dist/player.min.js
  Cache-Control: public, max-age=31536000, immutable

/dist/style.min.css
  Cache-Control: public, max-age=31536000, immutable

/app.min.js
  Cache-Control: public, max-age=31536000, immutable

/player.min.js
  Cache-Control: public, max-age=31536000, immutable

/style.min.css
  Cache-Control: public, max-age=31536000, immutable

