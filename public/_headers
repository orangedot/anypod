/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), camera=(), geolocation=()
  Content-Security-Policy: default-src 'self'; media-src 'self' blob: https:; img-src 'self' data: https:; script-src 'self' https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube.com; connect-src 'self' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/dist/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/dist/app.min.js
  Cache-Control: public, max-age=31536000, immutable

/dist/style.min.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: no-cache, no-store, must-revalidate

/style.css
  Cache-Control: no-cache, no-store, must-revalidate

